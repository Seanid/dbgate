{
  "name": "dbgate",
  "version": "1.0.0",
  "private": true,
  "description": "本地运行、只读、结构化的数据库查询服务：HTTP REST + MCP Server，支持多 MySQL 实例、按 appid 分表、跨实例遍历与结果归并",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/bootstrap.js http",
    "mcp": "node src/bootstrap.js mcp",
    "plan": "node scripts/plan.js",
    "table-scope": "node scripts/table-scope.js",
    "gen-token": "node scripts/gen-token.mjs",
    "test": "node --test \"test/*.test.js\"",
    "check-static": "node scripts/check-static.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fastify": "^5.2.0",
    "mysql2": "^3.11.5",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  }
}
